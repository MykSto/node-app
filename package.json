{
  "name": "@self/nasa",
  "version": "1.0.2",
  "private": true,
  "devDependencies": {
    "@nx/eslint": "^21.6.3",
    "@nx/js": "21.6.3",
    "@nx/vite": "^21.6.3",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/config": "^3.3.5",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "nx": "^21.6.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~4.5.0"
  },
  "scripts": {
    "build:code": "nx run-many -t build",
    "start:dev": "nx run-many -t start",
    "start:prod": "nx run --project=frontend build && nx run start --project=backend",
    "start:cluster": "nx run --project=frontend build && nx run cluster --project=backend",
    "lint:code": "nx run-many -t=lint --fix . --ext .ts,.tsx",
    "test:backend": "NODE_ENV=test nx run --project=backend test",
    "rm:dist": "./node_modules/.bin/rimraf {**/.nyc_output,**/coverage,**/dist,reports,**/node_modules}",
    "clean": "yarn rm:dist"
  },
  "packageManager": "yarn@4.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "axios": "^1.10.0",
    "config": "^4.0.0",
    "csv-parse": "^5.6.0",
    "mongoose": "^8.16.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
